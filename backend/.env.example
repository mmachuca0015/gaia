# Base de datos
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=

PORT=3001

# "production" activa la cookie Secure (solo HTTPS)
NODE_ENV=development

# Origen(es) permitidos del frontend, separados por coma.
# En produccion debe ser el dominio real: https://pila.mx
FRONTEND_URL=http://localhost:5173

RESEND_API_KEY=

# En LOCAL va la llave de PRUEBA (sk_test_...). La live se captura en el panel
# de Render y nunca se escribe aqui: este archivo si esta en el repositorio.
#
# Al arrancar se avisa en los logs si el modo de la llave no cuadra con
# NODE_ENV. Hace falta el aviso porque el desajuste no se ve: una llave de
# prueba en produccion responde exito a cada cobro y no mueve un peso.
STRIPE_SECRET_KEY=

# Firma de los webhooks. Sin esta variable /subscriptions/webhook responde 500
# a proposito: sin verificar la firma, cualquiera podria activarse una
# suscripcion gratis.
#
# El de local sale de:
#   stripe listen --forward-to localhost:3001/subscriptions/webhook
# y es distinto del de produccion, que lo da el panel de Stripe al registrar el
# endpoint real. Cambiar de modo prueba a live cambia este valor.
STRIPE_WEBHOOK_SECRET=
