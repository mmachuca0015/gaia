# Copia este archivo a .env y rellena los valores.
# El .env real no se sube al repositorio.

# URL del backend. En produccion la inyecta Render (https://api.wellcoapp.com).
VITE_API_URL=http://localhost:3001

# Llave PUBLICA de Stripe. En local la de prueba (pk_test_...); la live se
# captura en el panel de Render.
#
# Esta llave viaja al navegador, asi que no es un secreto, pero si tiene que
# ser del mismo modo que la secreta del backend: mezclar pk_live con sk_test
# hace que el pago falle al confirmarse, ya cobrado a medias.
VITE_STRIPE_PUBLIC_KEY=pk_test_...

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Pagina de reservas de Google Calendar para las demos. Mientras este vacia, la
# seccion de demo de la landing pide el correo y lo guarda en la waitlist, como
# antes. Al pegar aqui la URL, el boton pasa a abrir el calendario.
VITE_DEMO_BOOKING_URL=
